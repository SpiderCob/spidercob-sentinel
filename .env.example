# Copy to .env and fill in. See README.md's "Register your own GitHub App"
# section for how to get these three values via GitHub's manifest flow.
GITHUB_APP_ID=
# Paste the full PEM content on one line with literal \n between lines, or
# use a multi-line env var in your Docker/systemd config.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

PORT=8000

# Minimum severity level that counts as "blocking" for the Check Run
# conclusion (LOW | MEDIUM | HIGH | CRITICAL). Default: HIGH
SENTINEL_MIN_SEVERITY=HIGH

# Maximum number of PR files to scan per event. Default: 50
SENTINEL_MAX_PR_FILES=50

# ── Optional: LLM triage ────────────────────────────────────────────────
# Without these, every PR check still runs — findings are just listed by
# severity with no plain-English explanation. Nothing is sent to any LLM
# unless you set SENTINEL_LLM_PROVIDER.
SENTINEL_LLM_PROVIDER=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=
SENTINEL_OLLAMA_URL=
